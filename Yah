<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Yash Furniture | Premium Furniture</title>
<style>
:root{--dark:#211812;--gold:#c59a62;--cream:#f6f0e7;--white:#fffaf3}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{font-family:Arial,sans-serif;background:var(--cream);color:var(--dark)}
a{text-decoration:none;color:inherit}
.wrap{width:min(1150px,90%);margin:auto}
header{position:sticky;top:0;z-index:10;background:#211812f5;color:white}
nav{min-height:75px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.logo{font-family:Georgia,serif;font-size:25px;color:var(--gold)}
.logo small{display:block;font:10px Arial;letter-spacing:3px;color:white;margin-top:5px}
.links{display:flex;gap:25px;font-size:13px}
.links a:hover{color:var(--gold)}
.menu{display:none;background:none;color:white;border:1px solid #777;padding:9px}
.hero{min-height:620px;display:flex;align-items:center;color:white;background:linear-gradient(90deg,#211812f5,#21181280),url('https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1800&q=85') center/cover}
.hero-content{padding:90px 0;max-width:680px}
.kicker{color:var(--gold);text-transform:uppercase;letter-spacing:4px;font-size:12px;font-weight:bold}
h1{font:clamp(48px,8vw,88px)/.98 Georgia,serif;margin:24px 0}
h1 em{color:var(--gold);font-weight:normal}
.hero p{color:#e1d6cb;line-height:1.9;max-width:500px}
.buttons{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
.btn{display:inline-block;padding:15px 21px;border:1px solid var(--gold);font-size:12px;font-weight:bold;transition:.3s}
.btn.gold{background:var(--gold);color:#211812}
.btn:hover{transform:translateY(-4px);box-shadow:0 12px 25px #0003}
.strip{background:var(--gold);padding:22px 0;text-align:center;font-weight:bold;font-size:12px;letter-spacing:1px}
section{padding:85px 0}
.heading{font:clamp(36px,5vw,58px)/1.05 Georgia,serif;margin:15px 0}
.intro{color:#786b5e;line-height:1.8;max-width:550px}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:35px}
.collection{background:var(--white)}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.card{background:white;box-shadow:0 8px 25px #29190e10;transition:transform .4s,box-shadow .4s;overflow:hidden;transform-style:preserve-3d}
.card:hover{transform:translateY(-10px) rotateX(2deg);box-shadow:0 25px 45px #29190e25}
.card img{display:block;width:100%;height:270px;object-fit:cover;transition:transform .6s}
.card:hover img{transform:scale(1.07)}
.card-content{padding:23px}
.card h3{font:25px Georgia,serif;margin-bottom:12px}
.card p{font-size:14px;color:#796b5e;line-height:1.8;margin-bottom:18px}
.card a{font-size:12px;font-weight:bold;color:#94683d}
.about{background:#eae0d3}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.about-image{position:relative;padding:0 35px 35px 0}
.about-image img{width:100%;height:440px;object-fit:cover;box-shadow:0 20px 45px #21181230}
.stamp{position:absolute;bottom:0;right:0;background:var(--dark);color:white;padding:25px;font:24px Georgia,serif}
.stamp span{display:block;font:12px Arial;color:var(--gold);margin-top:8px}
.features{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:28px 0}
.feature{border-top:1px solid #c9b8a5;padding-top:15px}
.feature b{display:block;font:19px Georgia,serif;margin-bottom:8px}
.feature p{font-size:13px;line-height:1.7;color:#786b5e}
.why{background:var(--dark);color:white}
.why-grid{display:grid;grid-template-columns:1fr 1fr;gap:55px;align-items:center}
.why .intro{color:#c6b6a6}
.benefits{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.benefit{border:1px solid #ffffff25;padding:24px;transition:.3s}
.benefit:hover{border-color:var(--gold);transform:translateY(-5px)}
.benefit span{font-size:25px;color:var(--gold)}
.benefit h3{font:21px Georgia,serif;margin:14px 0 9px}
.benefit p{font-size:13px;color:#c6b6a6;line-height:1.7}
.contact{background:var(--white)}
.contact-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:45px}
.contact-box{background:var(--dark);color:white;padding:32px}
.contact-box h3,.contact-right h3{font:32px Georgia,serif;margin-bottom:14px}
.contact-box>p,.contact-right>p{line-height:1.8;font-size:14px;color:#c8b8a8;margin-bottom:22px}
.contact-row{border-top:1px solid #ffffff25;padding:18px 0;line-height:1.9}
.contact-row small{display:block;color:var(--gold);letter-spacing:2px;font-size:10px}
.contact-row a:hover{color:var(--gold)}
.contact-right{padding:15px 0}
.map{display:block;margin-top:25px;padding:22px;background:#f1e6d8;border:1px solid #dfcdb7;transition:.3s}
.map:hover{transform:translateY(-4px);border-color:var(--gold)}
.map b{display:block;margin-bottom:8px}
.map span{font-size:13px;color:#796b5e}
footer{background:#17110d;color:#c6b6a6;padding:25px 0;font-size:12px}
.footer{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}
.reveal{opacity:0;transform:translateY(20px);transition:.7s}
.reveal.show{opacity:1;transform:none}
.call{position:fixed;right:18px;bottom:18px;z-index:15;background:var(--gold);color:#211812;width:52px;height:52px;border-radius:50%;display:grid;place-items:center;font-size:23px;box-shadow:0 8px 25px #0003}
@media(max-width:760px){
 .menu{display:block}
 .links{display:none;position:absolute;top:75px;left:0;right:0;background:var(--dark);padding:20px;flex-direction:column;gap:0}
 .links.open{display:flex}
 .links a{padding:13px;border-bottom:1px solid #ffffff15}
 .hero{min-height:570px;background-position:60% center}
 .hero-content{padding:70px 0}
 .section-head{align-items:start;flex-direction:column}
 .cards{grid-template-columns:1fr}
 .card img{height:250px}
 .about-grid,.why-grid,.contact-grid{grid-template-columns:1fr;gap:35px}
 .about-image img{height:330px}
 section{padding:65px 0}
 .features,.benefits{gap:12px}
 .feature b{font-size:17px}
 .benefit{padding:17px}
 .footer{flex-direction:column}
}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}.reveal{opacity:1;transform:none}}
</style>
</head>
